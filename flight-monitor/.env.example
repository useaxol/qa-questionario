# ----------------------------------------------------------------- provedor
# 'synthetic' (simulador ancorado na tabela de benchmark, funciona sem
# credencial) ou 'amadeus' (cotação real).
FLIGHTWATCH_PROVIDER=synthetic
# Credenciais gratuitas em https://developers.amadeus.com
# AMADEUS_CLIENT_ID=
# AMADEUS_CLIENT_SECRET=
# Produção: https://api.amadeus.com  |  Teste (dados limitados): https://test.api.amadeus.com
AMADEUS_HOST=https://test.api.amadeus.com

# ------------------------------------------------- metodologia da cesta
# Mudar qualquer um destes quebra a comparabilidade da série histórica.
FLIGHTWATCH_BASKET_ORIGIN=GRU
# Antecedências sondadas por destino. Mantenha a contagem ÍMPAR: é o que faz a
# mediana ser uma cotação real, e não um valor entre duas.
FLIGHTWATCH_PROBE_HORIZONS=30,60,120
FLIGHTWATCH_PROBE_NIGHTS=10

# --------------------------------------------------------------- cadência
# 24 h × 10 destinos × 3 sondagens = 900 chamadas/mês (cota gratuita: 2.000).
# 720 (12 h) dobra para 1.800 — ainda cabe, com pouca folga.
FLIGHTWATCH_INTERVAL_MIN=1440
FLIGHTWATCH_JITTER_SEC=90

# ---------------------------------------------------------------- alertas
# Horas de carência antes de repetir o alerta do mesmo destino.
FLIGHTWATCH_ALERT_COOLDOWN_H=24
# Queda adicional (%) que fura a carência.
FLIGHTWATCH_ALERT_IMPROVE_PCT=3
FLIGHTWATCH_NOTIFY_CONSOLE=true
FLIGHTWATCH_NOTIFY_FILE=data/alerts.jsonl
# Webhook genérico; o payload traz 'text' e 'content' (Slack e Discord).
# FLIGHTWATCH_WEBHOOK_URL=https://hooks.slack.com/services/...

# --------------------------------------------------------------- servidor
FLIGHTWATCH_DB=data/flightwatch.db
FLIGHTWATCH_HOST=0.0.0.0
FLIGHTWATCH_PORT=10001
# FLIGHTWATCH_SECRET_KEY=troque-em-producao
